# Merge these lines into your EXISTING root .htaccess. Preserve HTTPS/www redirects.
# Apache mod_dir and mod_alias are normally available on PHP hosting.
# Reset any earlier DirectoryIndex list, then serve the real PHP homepage at /.
# Serving index.html at / would return a noindex compatibility redirect instead.
DirectoryIndex disabled
DirectoryIndex index.php index.html
RedirectMatch 301 ^/index\.html$ https://www.myphysiosaathi.in/
RedirectMatch 301 ^/pricing\.html$ https://www.myphysiosaathi.in/pricing.php
